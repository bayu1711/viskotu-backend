# Environment variables for Viskotu backend
# Copy this to .env and fill in real values

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/viskotu

# CORS — allow the Next.js dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT token lifetimes (seconds)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# Media files (local in dev, S3 in prod)
MEDIA_ROOT=media/
MEDIA_URL=/media/

# Stripe (fill in when wiring payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email backend
# For testing in terminal, use: django.core.mail.backends.console.EmailBackend
# For real emails via Gmail/SendGrid, use: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=your_gmail@gmail.com
