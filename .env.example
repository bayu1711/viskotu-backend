# ──────────────────────────────────────────────────────────────────────────────
# Viskotu Backend — Environment Variables
# Copy this file to .env and fill in the real values before running the server.
# NEVER commit the real .env file to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Set USE_SQLITE=False to use PostgreSQL (required for production)
USE_SQLITE=True
DB_NAME=viskotu
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── JWT Tokens ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# ── Media Files ───────────────────────────────────────────────────────────────
# In production, swap these for S3 (see AWS section below)
MEDIA_ROOT=media/
MEDIA_URL=/media/

# ── Email (Transactional) ─────────────────────────────────────────────────────
# For local dev/console output use: django.core.mail.backends.console.EmailBackend
# For SendGrid (production): EMAIL_HOST=smtp.sendgrid.net, USER=apikey, PASSWORD=<sendgrid_key>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@viskotu.com

# ── Paddle (Checkout & Subscriptions) ─────────────────────────────────────────
# Get from: https://vendors.paddle.com -> Developer Tools -> Authentication
PADDLE_API_KEY=
PADDLE_PRODUCT_ID=
# Get from: Paddle Dashboard -> Developer Tools -> Webhooks -> your webhook -> secret
PADDLE_WEBHOOK_SECRET=

# ── PayHere (Local LK Checkout) ───────────────────────────────────────────────
# Get from: https://sandbox.payhere.lk -> My Integrations -> Merchant Credentials
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=

# ── AWS (Rekognition KYC + S3 Media Storage) ──────────────────────────────────
# Create IAM user with AmazonRekognitionFullAccess + AmazonS3FullAccess policies
# Get from: AWS Console -> IAM -> Users -> Security Credentials -> Create Access Key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# S3 bucket name for media uploads (create at https://s3.console.aws.amazon.com)
AWS_STORAGE_BUCKET_NAME=

# ── Wise (International Supplier Payouts) ─────────────────────────────────────
# Get from: wise.com -> Settings -> API Tokens -> Create Token (Full Access)
WISE_API_TOKEN=
# Get your Business Profile ID: GET https://api.wise.com/v1/profiles
WISE_PROFILE_ID=

# ── WebSockets / Real-Time Chat (Production Redis) ────────────────────────────
# Not needed for local dev (InMemoryChannelLayer is used automatically).
# For production, provision a Redis instance (e.g. Redis Labs, Upstash, or AWS ElastiCache)
REDIS_URL=redis://localhost:6379
