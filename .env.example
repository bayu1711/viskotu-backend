# Environment variables for Viskotu backend
# Copy this to .env and fill in real values

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/viskotu

# CORS — allow the Next.js dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT token lifetimes (seconds)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# Media files (local in dev, S3 in prod)
MEDIA_ROOT=media/
MEDIA_URL=/media/

# Stripe (fill in when wiring payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email backend (console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
